{
  "name": "@criation/ui",
  "version": "0.2.0",
  "description": "Criation UI - A modern, modular, and reusable UI foundation for rapid website creation",
  "type": "module",
  "main": "./dist/index.umd.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./ui.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:lib": "tsc -b && vite build --config vite.config.lib.ts",
    "pretest": "npm run build:lib",
    "test": "node scripts/test-suite.js",
    "generate:pdf": "node scripts/generate-pdf.js",
    "preview": "vite preview"
  },
  "keywords": [
    "react",
    "ui-library",
    "design-system",
    "components",
    "criation-ui",
    "typescript"
  ],
  "author": "Divyanshu Kumar <143479650+Atomic-Quark@users.noreply.github.com>",
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "marked": "^18.1.1",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-dts": "^4.5.0"
  }
}
